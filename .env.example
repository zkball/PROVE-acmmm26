# Copy to .env or export in the shell. Do not commit real keys.
# Use a public OpenAI-compatible chat-completions endpoint.
# Do not put vendor-internal API bases or keys in this repository.

PROVE_API_KEY=sk-your-key
PROVE_BASE_URL=https://api.openai.com/v1
PROVE_MODEL=gpt-4o

# Optional
# PROVE_TIMEOUT=120
# PROVE_MAX_RETRIES=3
